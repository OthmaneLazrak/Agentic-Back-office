%% Architecture generale - Agent IA Back-Office KYC (Attijariwafa Bank)
%% Rendu : VS Code (extension Mermaid) ou https://mermaid.live
flowchart TB
    %% ---------------- Couche presentation ----------------
    subgraph FE["Frontend - React 19 / Vite (:5173)"]
        direction TB
        UI["Pages : KYC, Cheque, Dashboard,<br/>History, Admin, Login"]
        COMP["Composants : RiskGauge,<br/>BoxAnnotator, DossierDetailModal"]
        AUTHJS["Auth : keycloak-js + apiClient"]
    end

    %% ---------------- Securite ----------------
    KC["Keycloak<br/>realm awb-kyc (:8080)"]

    %% ---------------- Back-end metier ----------------
    subgraph SB["Spring Boot - Back-Office metier (:8000)"]
        direction TB
        CTRL["Controllers<br/>Auth / Kyc / Cheque / AdminUser"]
        SVC["Services<br/>KycService, ChequeService,<br/>AiOrchestratorService"]
        ENT["Entities + Repos (JPA)<br/>Dossier / Document / Correction / User"]
    end
    DB[("PostgreSQL<br/>kyc_db")]

    %% ---------------- Couche inference ----------------
    FAST["Python Agent Server - FastAPI (:8500)<br/>/agent/analyze - /cheque/analyze - /orchestrator/analyze"]

    %% ---------------- Agents + MCP ----------------
    subgraph AGENTS["Agents LangGraph + Serveurs MCP"]
        direction TB
        ORCH["orchestrator_agent<br/>routeur LLM (Ollama) + gestion VRAM"]
        subgraph KYCDOM["Domaine KYC"]
            KAG["kyc_agent"] --> KMCP["kyc_mcp_server (:7800, SSE)<br/>extractor / validator / reporter"]
        end
        subgraph CHQDOM["Domaine Cheque"]
            CAG["cheque_agent"] --> CMCP["cheque_mcp_server (:7810, SSE)<br/>extractor / validator / reporter"]
        end
        ORCH --> KAG
        ORCH --> CAG
    end

    %% ---------------- Modeles IA ----------------
    MODELS["Modeles IA<br/>Qwen2.5-VL LoRA - YOLOv8 - TrOCR"]

    %% ---------------- Boucle d'entrainement ----------------
    TRAIN["training/<br/>train_vlm_lora - train_yolo - train_trocr<br/>export_corrections (human-in-the-loop)"]

    %% ---------------- Liens ----------------
    FE -- "HTTP REST + JWT" --> SB
    FE -- "OAuth2 login" --> KC
    SB -- "validation JWT" --> KC
    SVC -- "JPA" --> DB
    SVC -- "HTTP (delegation IA)" --> FAST
    FAST --> ORCH
    KMCP --> MODELS
    CMCP --> MODELS
    ENT -. "corrections manuelles" .-> TRAIN
    TRAIN -. "fine-tuning" .-> MODELS

    %% ---------------- Styles ----------------
    classDef front fill:#FFF3E0,stroke:#E8821E,stroke-width:2px,color:#1e293b;
    classDef back fill:#E3EAF5,stroke:#1e293b,stroke-width:2px,color:#1e293b;
    classDef ai fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1e293b;
    classDef data fill:#ECEFF1,stroke:#455A64,stroke-width:2px,color:#1e293b;
    classDef sec fill:#FCE4EC,stroke:#AD1457,stroke-width:2px,color:#1e293b;

    class FE,UI,COMP,AUTHJS front;
    class SB,CTRL,SVC,ENT back;
    class FAST,AGENTS,ORCH,KAG,CAG,KMCP,CMCP,MODELS,TRAIN ai;
    class DB data;
    class KC sec;
